{
  "config_type": "disease",
  "schema_version": 1,
  "compartments": [
    "S",
    "E",
    "I",
    "R",
    "SV",
    "EV",
    "IV",
    "H",
    "D"
  ],
  "transitions": [
    {
      "name": "S_to_E",
      "origin": "S",
      "destination": "E",
      "rate_template": "force_of_infection",
      "rate_config": {
        "beta_param": "beta_baseline",
        "contact_matrix_schedule": "flu_contact_matrix",
        "infectious_compartments": {
          "I": "I_relative_infectiousness",
          "IV": "IV_relative_infectiousness"
        },
        "relative_susceptibility_param": "relative_suscept",
        "humidity_impact_param": "humidity_impact",
        "humidity_schedule": "absolute_humidity"
      }
    },
    {
      "name": "E_to_I",
      "origin": "E",
      "destination": "I",
      "rate_template": "constant_param",
      "rate_config": {
        "param": "E_to_I_rate"
      }
    },
    {
      "name": "I_to_R",
      "origin": "I",
      "destination": "R",
      "rate_template": "param_product",
      "rate_config": {
        "factors": [
          "I_out_rate"
        ],
        "complement_factors": [
          "I_to_H_prop"
        ]
      },
      "jointly_distributed_with": "I_to_H"
    },
    {
      "name": "I_to_H",
      "origin": "I",
      "destination": "H",
      "rate_template": "param_product",
      "rate_config": {
        "factors": [
          "I_out_rate",
          "I_to_H_prop"
        ]
      },
      "jointly_distributed_with": "I_to_R"
    },
    {
      "name": "S_to_SV",
      "origin": "S",
      "destination": "SV",
      "rate_template": "scheduled_exact",
      "rate_config": {
        "schedule": "vaccinated_transfer_schedule",
        "compartment_reset_date_mm_dd_param": "vaccinated_compartment_reset_date_mm_dd"
      }
    },
    {
      "name": "SV_to_EV",
      "origin": "SV",
      "destination": "EV",
      "rate_template": "force_of_infection",
      "rate_config": {
        "beta_param": "beta_baseline",
        "contact_matrix_schedule": "flu_contact_matrix",
        "infectious_compartments": {
          "I": "I_relative_infectiousness",
          "IV": "IV_relative_infectiousness"
        },
        "relative_susceptibility_param": "vax_susceptibility",
        "humidity_impact_param": "humidity_impact",
        "humidity_schedule": "absolute_humidity"
      }
    },
    {
      "name": "EV_to_IV",
      "origin": "EV",
      "destination": "IV",
      "rate_template": "constant_param",
      "rate_config": {
        "param": "EV_to_IV_rate"
      }
    },
    {
      "name": "IV_to_R",
      "origin": "IV",
      "destination": "R",
      "rate_template": "param_product",
      "rate_config": {
        "factors": [
          "I_out_rate"
        ],
        "complement_factors": [
          "IV_to_H_prop"
        ]
      },
      "jointly_distributed_with": "IV_to_H"
    },
    {
      "name": "IV_to_H",
      "origin": "IV",
      "destination": "H",
      "rate_template": "param_product",
      "rate_config": {
        "factors": [
          "I_out_rate",
          "IV_to_H_prop"
        ]
      },
      "jointly_distributed_with": "IV_to_R"
    },
    {
      "name": "H_to_R",
      "origin": "H",
      "destination": "R",
      "rate_template": "param_product",
      "rate_config": {
        "factors": [
          "H_out_rate"
        ],
        "complement_factors": [
          "H_to_D_prop"
        ]
      },
      "jointly_distributed_with": "H_to_D"
    },
    {
      "name": "H_to_D",
      "origin": "H",
      "destination": "D",
      "rate_template": "param_product",
      "rate_config": {
        "factors": [
          "H_out_rate",
          "H_to_D_prop"
        ]
      },
      "jointly_distributed_with": "H_to_R"
    }
  ],
  "transition_groups": [
    {
      "name": "I_out",
      "transition_type": "multinom_deterministic",
      "members": [
        "I_to_R",
        "I_to_H"
      ]
    },
    {
      "name": "IV_out",
      "transition_type": "multinom_deterministic",
      "members": [
        "IV_to_R",
        "IV_to_H"
      ]
    },
    {
      "name": "H_out",
      "transition_type": "multinom_deterministic",
      "members": [
        "H_to_R",
        "H_to_D"
      ]
    }
  ],
  "epi_metrics": [],
  "schedules": [
    {
      "name": "absolute_humidity",
