          "type": "data",
          "data": {
            "text/html": "<details open style=\"border:1px solid rgba(127,127,127,0.25);border-left:4px solid #2e7d6b;border-radius:10px;padding:0.8rem 1rem;margin:0.45rem 0;background:rgba(127,127,127,0.03);\"><summary style=\"cursor:pointer;list-style:none;display:flex;align-items:flex-start;gap:.5rem;\"><span class=\"_clt_acc_arrow\" style=\"display:inline-flex;align-items:center;justify-content:center;height:1.7em;flex:none;transition:transform .15s;\">\u25b6</span><span style=\"flex:1 1 auto;min-width:0;\"><div style=\"display:flex;align-items:center;gap:.55rem;margin:.1rem 0 .15rem;\"><span style=\"display:inline-flex;align-items:center;justify-content:center;min-width:1.7em;height:1.7em;padding:0 .45em;border-radius:999px;background:#2e7d6b;color:#fff;font-weight:700;font-size:.95rem;line-height:1;flex:none;\">\u2460</span><span style=\"font-size:1.06rem;font-weight:700;color:#2e7d6b;\">Population Structure</span></div><div style=\"color:#777;font-size:.82rem;margin:.05rem 0 0 2.25rem;\">Age groups, risk groups, and single-population vs. metapopulation.</div></span></summary><style>summary::-webkit-details-marker{display:none;}details[open]>summary>._clt_acc_arrow{transform:rotate(90deg);}</style><div style=\"margin-top:0.5rem;\"><div style='display: flex;flex: 1;flex-direction: column;justify-content: flex-start;align-items: normal;flex-wrap: nowrap;gap: 0.5rem'><span class=\"markdown prose dark:prose-invert contents\"><span class=\"paragraph\">Define the population dimensions and geography here. The rest of the model (compartments, transitions, parameters, \u2026) is built in the <strong>Model Builder</strong> tab.</span></span><marimo-ui-element object-id='Hstk-0' random-id='31db071d-5688-2a4f-4fe9-5ebfd48d6b34'><marimo-radio data-initial-value='&quot;Count only&quot;' data-label='&quot;&lt;span class=&#92;&quot;markdown prose dark:prose-invert contents&#92;&quot;&gt;&lt;span class=&#92;&quot;paragraph&#92;&quot;&gt;Age-group specification&lt;/span&gt;&lt;/span&gt;&quot;' data-options='[&quot;Count only&quot;,&quot;Named age bands&quot;]' data-inline='false' data-disabled='false'></marimo-radio></marimo-ui-element><marimo-ui-element object-id='Hstk-1' random-id='718ac5e3-9c91-ca8a-4b3a-1349343e383a'><marimo-number data-initial-value='3' data-label='&quot;&lt;span class=&#92;&quot;markdown prose dark:prose-invert contents&#92;&quot;&gt;&lt;span class=&#92;&quot;paragraph&#92;&quot;&gt;Number of age groups (A)&lt;/span&gt;&lt;/span&gt;&quot;' data-start='1' data-stop='20' data-step='1' data-debounce='false' data-full-width='false' data-disabled='false'></marimo-number></marimo-ui-element><marimo-callout-output data-html='&quot;&lt;span class=&#92;&quot;markdown prose dark:prose-invert contents&#92;&quot;&gt;&lt;span class=&#92;&quot;paragraph&#92;&quot;&gt;Count-only mode: contact matrices cannot be fetched (the fetcher needs age-band definitions). For A &amp;gt; 1, either switch to &lt;strong&gt;Named age bands&lt;/strong&gt; to fetch them, or supply contact-matrix CSVs in Model Builder \u2192 Step 4.&lt;/span&gt;&lt;/span&gt;&quot;' data-kind='&quot;info&quot;'></marimo-callout-output><marimo-ui-element object-id='Hstk-3' random-id='39776d81-956e-eab8-73ac-7f07e36a9e89'><marimo-number data-initial-value='2' data-label='&quot;&lt;span class=&#92;&quot;markdown prose dark:prose-invert contents&#92;&quot;&gt;&lt;span class=&#92;&quot;paragraph&#92;&quot;&gt;Number of risk groups (R)&lt;/span&gt;&lt;/span&gt;&quot;' data-start='1' data-stop='10' data-step='1' data-debounce='false' data-full-width='false' data-disabled='false'></marimo-number></marimo-ui-element><marimo-ui-element object-id='Hstk-4' random-id='a629c5ce-01e2-2cd2-2539-695db9beccbd'><marimo-radio data-initial-value='&quot;Metapopulation&quot;' data-label='&quot;&lt;span class=&#92;&quot;markdown prose dark:prose-invert contents&#92;&quot;&gt;&lt;span class=&#92;&quot;paragraph&#92;&quot;&gt;Population mode&lt;/span&gt;&lt;/span&gt;&quot;' data-options='[&quot;Single population&quot;,&quot;Metapopulation&quot;]' data-inline='false' data-disabled='false'></marimo-radio></marimo-ui-element><marimo-ui-element object-id='Hstk-5' random-id='cdc469c7-a5cb-f8a0-5968-494e20c69316'><marimo-text data-initial-value='&quot;generic_core/examples/example_metapop_inputs&quot;' data-label='&quot;&lt;span class=&#92;&quot;markdown prose dark:prose-invert contents&#92;&quot;&gt;&lt;span class=&#92;&quot;paragraph&#92;&quot;&gt;Metapopulation folder path&lt;/span&gt;&lt;/span&gt;&quot;' data-placeholder='&quot;/path/to/metapop_folder/&quot;' data-kind='&quot;text&quot;' data-full-width='true' data-disabled='false' data-debounce='true'></marimo-text></marimo-ui-element><marimo-callout-output data-html='&quot;&lt;span class=&#92;&quot;markdown prose dark:prose-invert contents&#92;&quot;&gt;&lt;ul&gt;&#92;n&lt;li&gt;&lt;strong&gt;metapop_config.json&lt;/strong&gt;: OK (required)&lt;/li&gt;&#92;n&lt;li&gt;&lt;strong&gt;absolute_humidity.csv&lt;/strong&gt;: OK (optional shared)&lt;/li&gt;&#92;n&lt;li&gt;&lt;strong&gt;mobility_modifier.csv&lt;/strong&gt;: OK (optional shared)&lt;/li&gt;&#92;n&lt;li&gt;&lt;strong&gt;subpopulations&lt;/strong&gt;: OK (2: SubpopA, SubpopB)&lt;/li&gt;&#92;n&lt;li&gt;&lt;strong&gt;travel_matrix&lt;/strong&gt;: OK (2\u00d72, rows sum to 1)&lt;/li&gt;&#92;n&lt;li&gt;&lt;strong&gt;initial_conditions_SubpopA.json&lt;/strong&gt;: OK (initial conditions)&lt;/li&gt;&#92;n&lt;li&gt;&lt;strong&gt;school_work_calendar_SubpopA.csv&lt;/strong&gt;: OK (calendar)&lt;/li&gt;&#92;n&lt;li&gt;&lt;strong&gt;vaccines_SubpopA.csv&lt;/strong&gt;: OK (vaccines)&lt;/li&gt;&#92;n&lt;li&gt;&lt;strong&gt;initial_conditions_SubpopB.json&lt;/strong&gt;: OK (initial conditions)&lt;/li&gt;&#92;n&lt;li&gt;&lt;strong&gt;school_work_calendar_SubpopB.csv&lt;/strong&gt;: OK (calendar)&lt;/li&gt;&#92;n&lt;li&gt;&lt;strong&gt;vaccines_SubpopB.csv&lt;/strong&gt;: OK (vaccines)&lt;/li&gt;&#92;n&lt;/ul&gt;&lt;/span&gt;&quot;' data-kind='&quot;success&quot;'></marimo-callout-output></div></div></details>"
